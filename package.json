{
  "name": "spab-gedeg",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run validate && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "validate": "tsx scripts/validate.ts",
    "release:check": "tsx scripts/validate.ts --operational",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "export:print": "tsx scripts/export-print.tsx",
    "export:video": "tsx scripts/export-video.ts",
    "export:verify": "tsx scripts/verify-exports.ts",
    "export:registration": "tsx scripts/export-registration.tsx"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
